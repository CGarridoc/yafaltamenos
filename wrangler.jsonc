{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yafaltamenos",
  "main": "worker.js",
  "compatibility_date": "2025-09-27",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "not_found_handling": "404-page"
  },
  "kv_namespaces": [
    {
      "binding": "VOTES",
      "id": "adcca4998c694f20854fb187f39e6c00"
    }
  ]
}
